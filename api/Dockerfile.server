# 웹 서버용 API 이미지 (EC2 / ECS / 로컬 compose). Lambda 용은 api/Dockerfile
# 빌드는 저장소 "루트"에서:  docker build -f api/Dockerfile.server -t energy-api .
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1

COPY api/requirements.txt api/requirements-server.txt api/
RUN pip install --no-cache-dir -r api/requirements-server.txt

# 전처리·학습·예측 코드와 학습용 샘플 데이터 (저장소와 같은 폴더 구조)
COPY scripts/resstock_prep.py scripts/resstock_train.py scripts/resstock_predict.py scripts/
COPY data/ data/

# 모델은 이 이미지의 라이브러리 버전으로 빌드 때 학습 (버전 불일치 방지, 1~3분)
# --experiment: 학습 60%로 만든 v1. data/retrain_logs.csv.gz(정답 있는 서비스 로그)가 있으면 더해 학습한 v2
RUN python scripts/resstock_train.py --experiment

COPY api/lambda_function.py api/server.py api/

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/', timeout=4)"

# 메모리가 작은 EC2 에서도 돌도록 worker 1개 + thread 4개 (모델은 worker 당 한 번 로드)
CMD ["gunicorn", "--chdir", "api", "--bind", "0.0.0.0:8000", "--workers", "1", "--threads", "4", "--timeout", "60", "server:app"]
